# Public (browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
# optional, defaults to the EU host
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
# Realtime transport: supabase (default) | ably | partykit
NEXT_PUBLIC_REALTIME_TRANSPORT=supabase
NEXT_PUBLIC_ABLY_KEY=
NEXT_PUBLIC_PARTYKIT_HOST=

# Server only (never prefixed NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
# Signs status share card links (/api/og/status/<id>.<sig>); any long random string, e.g. `openssl rand -base64 32`.
# Unset: links are signed with SUPABASE_SERVICE_ROLE_KEY (production logs a warning), so rotating that key breaks them.
SHARE_CARD_SECRET=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
INITIAL_OWNER_EMAIL=
